{% set has_animation = theme.settings.get('has_animation') %}

{% if btn_txt %}
	<a href="{{btn_url}}" class="All_banner_btn relative px-4 md:px-[26px] py-2 md:py-3 flex items-center gap-[14px] text-center {{ has_animation ? 'Al__anime' }}"
		style="font-size: clamp(0.875rem, 0.7213rem + 0.6557vw, 1.5rem); color: {{ btn_color }}; background:{{ btn_bg }}; --btn-bg:{{ btn_bg }};"
		{% if has_animation %} data-anim-allura="fade" data-dur-allura="0.7s" {% endif %}
	>
		{{ btn_txt }}
		<i class="sicon-arrow-left"></i>
	</a>
{% endif %}