{% set c = component %}
<section class = "AL_Products_with_sideBanner mb-12">
    <div class = "container flex flex-col md:flex-row gap-6 ">
        <div class = "banner md:max-w-[348px] w-full">
            {% if c.switch_video %}
                <div class = "video_banner w-full h-[432px] md:h-full">
					<video autoplay muted loop playsinline class= "w-full object-cover h-full">
						<source src="{{ c.video_banner_link }}" type="video/mp4"/>
						Your browser does not support the video tag.
					</video>
				</div>
            {% else %}
                <div class = "image_div w-full h-[432px] md:h-full">
                    <img src="{{ c.image_banner }}" alt="" class= "w-full object-fill md:object-cover h-full">
                </div>
            {% endif %}
        </div>
        <div class = "items grid grid-cols-1 md:grid-cols-2 w-full gap-[1rem] md:gap-6">
            {% for product in c.products %}
                <custom-salla-product-card horizontal product="{{product}}"></custom-salla-product-card>
            {% endfor %}
        </div>
    </div>
</section>

<style>
    .header h2::after{
            content: "";
            position: absolute;
            bottom: -1px;
            left: 0;
            right: 0;
            width: 100%;
            height: 2px;
            background-color: #597445;
    }
    .items custom-salla-product-card {
        height : 178px;
        border-radius: 0;

    }
    .items custom-salla-product-card .s-product-card-image{
        border-top-right-radius: 0;
        border-bottom-right-radius: 0;
        width: 40%;
    }
    .items custom-salla-product-card .s-product-card-content{
       
        justify-content: center;
        margin: auto;
    }
    
    .items custom-salla-product-card .s-product-card-image img{
        background-color: #fff;
    }

</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".items custom-salla-product-card").forEach(card => {
            card.classList.remove("s-product-card-vertical");
            card.classList.add("s-product-card-horizontal");
        });
    });
</script>