{% set c = component %}
<section class = "AL_Products_with_sideBanner my-5">
    <div class = "header container text-center my-2">
        <h2 style = "color: {{ c.section_title_color }};">{{ c.Section_title }}</h2>
    </div>

    <div class = "container flex flex-row">
        <div class = "banner">
            {% if c.switch_video %}
                <div class = "video_banner">
					<video autoplay muted loop playsinline>
						<source src="{{ c.video_banner_link }}" type="video/mp4"/>
						Your browser does not support the video tag.
					</video>
				</div>
            {% else %}
                <div class = "image_div">
                    <img src="{{ c.image_banner }}" alt="">
                </div>
            {% endif %}
        </div>
        <div class = "products flex flex-row">
            {% for product in c.products %}
                <custom-salla-product-card product="{{product}}"></custom-salla-product-card>
            {% endfor %}
        </div>
        
    </div>
</section>