<section class="w-full h-[244px] relative my-5">
	<salla-slider id="thumbs" show-controls="false" type="thumbs" slider-config='{"breakpoints": {"350": {"slidesPerView": 4, "spaceBetween": 0}}}'>
		<div slot="items">
			{% for img in component.section_images %}
				<img src="{{ img.image }}" alt="image" class="h-full object-cover" loading="lazy"/>
			{% endfor %}
		</div>
	</salla-slider>
	{% if component.enable_floating_banner %}
		<div class="text-center rounded-md absolute !z-[10] top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 flex items-center justify-center flex-col text-white" style="background: rgba(89, 116, 69, 0.16); backdrop-filter: blur(7.5px); width: 254px; height: 114px;">
			<p class="text-2xl">{{ component.username }}</p>
			<p class="text-[20px] leading-[40px]">{{ component.slogan }}</p>
		</div>
	{% endif %}
</section>