<section class="AL-best_category my-10 py-7 md:my-20"
		{% if component.category_image %} style="background-image: url('{{ component.category_image }}');" {% endif %}>
	<div class="container">

		{% if component.category_title or component.category_sub_title %}
			<div class="AL-best_category_titles text-center">
				
				{% if component.category_title %}
					<h3 class="AL-best_category_titles_title md:text-xl opacity-70 mb-3"> {{ component.category_title }} </h3>
				{% endif %}

				{% if component.category_sub_title %}
					<p class="AL-best_category_titles_description font-bold text-xl md:text-[28px]"> {{ component.category_sub_title }} </p>
				{% endif %}
				
			</div>
		{% endif %}

		{# template to include shadow root #}
		{% if component.categories|length > 0 %}
			<template id="AL-best_category_tabs">

				<ul class="AL-best_category_tabs_container">
					{% for tab in component.categories %}
						<li class="AL-best_category_tabs_item {{ loop.first ? 'tab_active' : '' }}">
							<button class="AL-best_category_tabs_btn"> {{ tab.category_name }} </button>
						</li>
					{% endfor %}
				</ul>

				<div class="AL-best_category_tabs_content">
					{% for tab in component.categories %}
						<slot name="{{ tab.category_name }}"></slot>
					{% endfor %}
				</div>

				<style>
					.AL-best_category_tabs_container {
						list-style: none;
						display: flex;
						flex-direction: column;
						justify-content: space-evenly;
					}
					.AL-best_category_tabs_item .AL-best_category_tabs_btn {
						cursor: pointer;
						background: transparent;
						border: none;
						position: relative;
						padding-right: 0;
						font-weight: 700;
						font-size: clamp(1.25rem, 1.0656rem + 0.7869vw, 2rem);
						opacity: 0.5;
					}
					.AL-best_category_tabs_item.tab_active .AL-best_category_tabs_btn {
						opacity: 1;
					}
					.AL-best_category_tabs_item.tab_active .AL-best_category_tabs_btn::after {
						content: '';
						position: absolute;
						bottom: 0;
						right: 0;
						width: 100%;
						height: 2px;
						background: #000;
					}
				</style>

			</template>
		{% endif %}

		{# custom tab to send data in it #}
		{# {% if component.categories|length > 0 %}
			<custom-tabs id="AL-best_category_products" class="grid grid-cols-1 md:grid-cols-2 mt-10">

				{% for category in component.categories %}
					
					<tab-content slot="{{ category.category_name }}" {% if not loop.first %} hidden {% endif %}>
						<salla-products-slider
							source-value="{{ category.relate_category[0] }}"
							slider-id="slider-for-product-{{ loop.index }}"
							slider-config='{
								"slidesPerView": 1,
								"spaceBetween": 0,
								"centerInsufficientSlides": true
							}'
						></salla-products-slider>
					</tab-content>

				{% else %}
					when no product show that
					<p>no products to show</p>
					
				{% endfor %}

			</custom-tabs>
		{% endif %} #}

	</div>
</section>
