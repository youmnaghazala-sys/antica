<section class="AL-best_category my-10 py-7 md:my-20"
    {% if component.category_image %} style="background-image: url('{{ component.category_image }}');" {% endif %}>
    <div class="container">

        {% if component.category_title or component.category_sub_title %}

            <div class="AL-best_category_titles text-center">
                {% if component.category_title %}
                    <h3 class="AL-best_category_titles_title md:text-xl opacity-70 mb-3" style="{{ component.category_title_color }}"> {{ component.category_title }} </h3>
                {% endif %}

                {% if component.category_sub_title %}
                    <p class="AL-best_category_titles_description font-bold text-xl md:text-[28px]" style="color: {{ component.category_sub_color }}"> {{ component.category_sub_title }} </p>
                {% endif %}

            </div>

        {% endif %}

        {% if component.categories|length > 0 %}

            <template id="AL-best_category_tabs">

                <ul class="AL-best_category_tabs_container">
                    {% for tab in component.categories %}
                        <li class="AL-best_category_tabs_item {{ loop.first ? 'tab_active' : '' }}">
                            <button class="AL-best_category_tabs_btn" style="{{ component.category_name_color }}"> {{ tab.category_name }} </button>
                        </li>
                    {% endfor %}
                </ul>

                <div class="AL-best_category_tabs_content">
                    {% for tab in component.categories %}
                        <slot name="{{ tab.category_name }}"></slot>
                    {% endfor %}
                </div>

                <style>
                    .AL-best_category_tabs_container {
                        list-style: none;
                        display: flex;
                        flex-direction: column;
                        justify-content: center;
                        gap: 32px;
                    }
                    .AL-best_category_tabs_item .AL-best_category_tabs_btn {
                        cursor: pointer;
                        background: transparent;
                        border: none;
                        position: relative;
                        padding-right: 0;
                        font-weight: 700;
                        font-size: clamp(1.25rem, 1.0656rem + 0.7869vw, 2rem);
                        opacity: 0.5;
                    }
                    .AL-best_category_tabs_item.tab_active .AL-best_category_tabs_btn {
                        opacity: 1;
                    }
                    .AL-best_category_tabs_item.tab_active .AL-best_category_tabs_btn::after {
                        content: '';
                        position: absolute;
                        bottom: 0;
                        right: 0;
                        width: 100%;
                        height: 2px;
                        background: #000;
                    }
                </style>
            </template>

            <custom-tabs id="AL-best_category_products" class="grid grid-cols-1 md:grid-cols-2 mt-10">
                
				{% for category in component.categories %}
                    <tab-content class="relative" slot="{{ category.category_name }}" {% if not loop.first %} hidden {% endif %}>
                        <salla-products-slider
                            source-value="{{ category.relate_category[0] }}"
                            source="categories"
                            slider-id="slider-for-product-{{ loop.index }}"
                            slider-config='{
                                "slidesPerView": 1,
                                "spaceBetween": 0,
                                "centerInsufficientSlides": true
                            }'
                        ></salla-products-slider>

						{% if category.unique_feature_1 %}
							<span class="product-unique-feature feature-1" style="border-color: {{ component.category_name_color }};"> {{ category.unique_feature_1 }} </span>
						{% endif %}

						{% if category.unique_feature_2 %}
							<span class="product-unique-feature feature-2" style="border-color: {{ component.category_name_color }};" > {{ category.unique_feature_2 }} </span>
						{% endif %}
						
						{% if category.unique_feature_3 %}
							<span class="product-unique-feature feature-3"  style="border-color: {{ component.category_name_color }};"> {{ category.unique_feature_3 }} </span>
						{% endif %}

                    </tab-content>
                {% endfor %}

            </custom-tabs>

        {% endif %}

    </div>
</section>


<style>
	.AL-best_category {
		.s-products-slider-slider {
			    max-width: 50%;
    			margin: 0 auto;
				@media (max-width: 400px) {
			    	max-width: 65%;
				}
				@media (min-width: 400px) and (max-width: 768px) {
			    	max-width: 45%;
				}
				.swiper {
					margin: 0 auto;
					padding: 0 !important;
				}
		}
		.s-slider-block__title-nav {
			width: 150% !important;
		}
		.s-product-card-entry {
			background: transparent;
		}
		.s-product-card-shadow:hover {
			box-shadow: none;
		}
		.s-product-card-image {
			border-radius: 0;
		}
		.s-product-card-content-footer {
			display: none;
		}
		.s-product-card-image {
			aspect-ratio: 1/1.5;
		} 

		.product-unique-feature {
			position: absolute;
            border-bottom: 2px solid #000;
            padding-bottom: 15px;
            padding-inline: 15px;
            font-size: 29.021px;
            line-height: 29px; 
            z-index: 2;
		}

		.product-unique-feature.feature-1 {
            top: 15%;
            right: 9%;
    
		}
		.product-unique-feature.feature-1::after{
            color: #000;
        }
		.product-unique-feature.feature-2 {
            top: 60%;
            right: 9%;
		}

		.product-unique-feature.feature-3 {
            top: 50%;
		}

	}
</style>
