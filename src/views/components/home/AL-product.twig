<section class="AL_product_slider">
    <div class="container">
        {% if component.grid_switch %}
        
        <salla-products-slider 
            source="latest"
            slider-id="096176"
            show-controls="false" 
                slider-config='{
                    "slidesPerView": 1,
                    "spaceBetween": 5,
                    "breakpoints": {
                        "320": { "slidesPerView": 1, "spaceBetween": 5 },
                        "640": { "slidesPerView": 2, "spaceBetween": 8 },
                        "1024": { "slidesPerView": {{component.slider_num_preview}}, "spaceBetween": 20 }
                    }
                }'>
        </salla-product-slider>
        {% elseif %}
            <div class="product-grid">
                {% for item in component.show_product_drop %}
                    <div class="product-card">
                        <salla-product-card
                            minimal="false"
                            special="true">
                        </salla-product-card>
                    </div>
                {% endfor %}
            </div>    
        {% endif %}
    </div>
</section>


<style>
    .AL_product_slider .s-slider-block__title{
        display: none !important;
    }

</style>