<section class="al-testimonial py-10">
    <div class="grid grid-cols-1 md:grid-cols-3">
            <!-- معلومات القسم -->
        <div  class="hidden md:flex flex-col items-center text-right justify-center bg-cover bg-center h-[394px] p-6 px-6 rounded-md shadow-lg"
            style="background-image: url('{{ component.m_img }}');">
                <div class="w-44">
                    {% if component.component_name %}
                        <h4 class="text-sm font-medium" style="color: {{ component.base_color }};">
                            {{ component.component_name }}
                        </h4>
                    {% endif %}

                    {% if component.about_component %}
                        <h3 class="text-xl md:text-[28px] font-semibold mt-2 leading-12" style="color: {{ component.tittle_color }};">
                            {{ component.about_component }}
                        </h3>
                    {% endif %}

                    <hr class="w-auto h-[3px]  my-3" style="background-color:{{component.line_color}};">

                    {% if component.component_description %}
                        <p class="text-sm md:text-base font-light" style="color: {{ component.description_color }};">
                            {{ component.component_description }}
                        </p>
                    {% endif %}
                </div>
        </div>
            
        <div class="md:col-span-2 flex items-center md:translate-x-[10%] lg:max-w-[90%]">
            <!-- السلايدر -->
            {% if component.slider_collection %}
                <div class="w-full">
                    <salla-slider id="thumbs" show-controls="true" type="thumbs"
                        slider-config='{
                            "slidesPerView": 1,
                            "spaceBetween": 5,
                            "breakpoints": {
                                "320": { "slidesPerView": 1, "spaceBetween": 5 },
                                "480": { "slidesPerView": 1.5, "spaceBetween": 6 },
                                "640": { "slidesPerView": 2, "spaceBetween": 8 },
                                "1024": { "slidesPerView": 3, "spaceBetween": 20 }
                            }
                        }'>
                        <div slot="items" class="flex flex-wrap justify-center gap-4">
                            {% for card in component.slider_collection %}
                                <div class="card h-auto shadow-lg border border-gray-200 p-6 rounded-md relative" style="background-color:{{component.card_background_color}};">
                                    <span class="absolute top-2 right-2  text-2xl" style="color:{{component.quats_color}}">
                                        <span class="sicon-quote-close"></span>
                                    </span>

                                    <div class="flex flex-row  items-center text-center">
                                        {% if card.comment_body %}
                                            <p class="text-[14px] font-normal leading-[22px] w-1/2" style="color:{{component.comment_body_color}};">
                                                {{ card.comment_body }}
                                            </p>
                                        {% endif %}

                                        <div class="product-div flex flex-col items-center mt-4 w-1/2">
                                            {% if card.product_img %}
                                                <img src="{{ card.product_img }}" alt="صورة المنتج" class="w-[100px] h-[85px] rounded-md shadow-md">
                                            {% endif %}

                                            {% if card.product_name %}
                                                <h3 class="text-[14px] font-semibold mt-2" style="color:{{component.product_name_color}};">
                                                    {{ card.product_name }}
                                                </h3>
                                            {% endif %}
                                        </div>
                                    </div>

                                    <div class="flex items-center justify-start gap-4 mt-4">
                                        {% if card.comment_writer_image %} 
                                            <img src="{{ card.comment_writer_image }}" alt="صورة المستخدم" class="w-10 h-10 rounded-full border">
                                        {% endif %}

                                        <div class="text-left">
                                            {% if card.comment_writer_job %}    
                                                <p class="font-normal text-[14px]" style="color: {{component.comment_writer_color}};">
                                                    {{ card.comment_writer_job }}
                                                </p>
                                            {% endif %}
                                        </div>
                                    </div>

                                    <span class="absolute bottom-2 left-2 text-2xl" style="color:{{component.quats_color}}" >
                                        <span class="sicon-quote-open"></span>
                                    </span>
                                </div>
                            {% endfor %}
                        </div>
                    </salla-slider>
                </div>
            {% endif %}
        </div>
    </div>
</section>


<style> 
    .s-slider-v-centered .s-slider-block__title-nav {
        color: white;
        width: 35px;
        height: 35px;
        border-radius: 50%;
        position: absolute;
    }
    
    .al-testimonial .s-slider-v-centered .s-slider-block__title-nav{
           top: -15% !important;
        left: 10%;
    }

    .s-slider-nav-arrow {
        border-radius: 0px;
        padding: 10px;
        box-shadow: 1px 1px 2px 2px white !important;
        background-color : {{component.arrow_color}} !important;
    }

      
    @media (max-width: 576px) { 
        .al-testimonial .s-slider-v-centered .s-slider-block__title-nav {
            left: 20%;
        }
    }
  
</style>


