<section class="LA_limited-time-offers">
  <div>
    <salla-slider show-controls="false" id="offers-slider-{{position}}">
      <div slot="items">
        {% for offer in component.offers %}
          <div>
            <div class="relative offers-slider-item min-h-[388px] md:min-h-[550px]">
              <div class="offers-slider-item-wrapper flex flex-col md:flex-row items-center relative z-2 min-h-[388px] md:min-h-[550px]">
                <div class="offers-slider-item-content w-full md:w-1/2">
                  <p style="color: {{component.title_color}}" class="offers-slider-item-content-title">{{offer.title}}</p>
                  <div class="relative offers-slider-item-content-primary w-fit" >
                    <h2 style="color: {{component.primary_text_color}}">{{offer.primary_text}}</h2>
                    <div class="absolute h-px w-full b-0 left-0" style="background-color: {{component.primary_text_color}}"></div>
                  </div>
                  <p style="color: {{component.sub_text_color}}" class="offers-slider-item-content-sub">{{offer.sub_text}}</p>
                  <div class="w-fit offers-slider-item-content-button">
                    {% include 'components.custom.button' with {'btn_txt': offer.button_label, 'btn_bg': component.button_color, 'btn_color': component.button_label_color } %}
                  </div>
                </div>
                <div class="w-full md:w-1/2" style="color: {{component.counter_color}}">
                  <salla-count-down
                    digits="en"
                    size="md"
                    labeled="true"
                    date="2025-11-12">
                  </salla-count-down>
                </div>
              </div>
              <div class="w-full h-full absolute top-0 left-0 z-1">
                <picture class="w-full h-full object-cover">
                  <source media="(max-width: 767px)" srcset="{{ offer.offer_image_mobile }}">
                  <img src="{{ offer.offer_image }}" alt="Offer Image" class="w-full h-full object-cover">
                </picture>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </salla-slider>
  </div>
</section>

<style>
  .offers-slider-item .s-count-down-dark .s-count-down-item:after{
    background-color: {{ component.counter_color ? component.counter_color : '#ffffff' }};
  }
  .offers-slider-item .s-count-down-item-label, .offers-slider-item .s-count-down-item {
    color: {{ component.counter_color ? component.counter_color : '#ffffff' }} ;
  }
</style>