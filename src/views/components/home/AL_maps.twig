<section class="s-block relative AL__maps">
	<salla-tabs>
		{% for location in component.locations %}
			<salla-tab-header slot="header" name="tab_{{ loop.index }}" class="text-[#838383]">
				<span class="font-bold text-sm sm:text-[1.5rem] sm:leading-6">
					{{ location.name }}
				</span>
			</salla-tab-header>
			<salla-tab-content slot="content" name="tab_{{ loop.index }}">
				<div class="h-[608px] sm:h-[662px] mb-4">
					<iframe src="{{ location.url }}" width="100%" height="100%" allowfullscreen="true" loading="lazy"></iframe>
				</div>
				<div class="AL__maps-content">
					<div class="p-4">
						<div class="mt-9 sm:mt-20">
							<h1 class="text-primary text-xl sm:text-2xl font-bold">
								<i class="sicon-location text-[var(--scound-color)] ml-2"></i>
								{{ trans('blocks.footer.title') }}
							</h1>
							<p class="text-base text-primary">
								{{ location.location_address }}
							</p>
						</div>

						<div class="phone mt-8 sm:mt-14">
							<h1 class="text-primary text-xl sm:text-2xl font-bold">
								<i class="sicon-phone-talking text-[var(--scound-color)] ml-2"></i>
								{{ trans('blocks.footer.phone') }}
							</h1>
							<p class="text-base text-primary">
								{{ location.location_phone }}
							</p>
						</div>

						<salla-social class="AL__maps-socialIcons"></salla-social>
					</div>
				</div>
			</salla-tab-content>
		{% endfor %}
	</salla-tabs>
</section>
