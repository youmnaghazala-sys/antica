{% set has_animation = theme.settings.get('has_animation') %}

<section class="AL-blog h-[514px] sm:h-[500px]">
    <div class="container">
        <div class="flex items-center justify-between flex-col sm:flex-row gap-1 sm:gap-6 py-0 sm:py-12 {{ has_animation ? 'Al__anime' }}" style="background-color:{{component.bg_color}};"
            {% if has_animation %} data-anim-allura="fade" data-dur-allura="0.5s" {% endif %}
        >
            <div class="swiper content-slider {{ theme.settings.get('has_animation') ? 'Al__anime' }}" {% if theme.settings.get('has_animation') %} data-anim-allura="fade" data-dur-allura="0.8s" {% endif %}>
                <div class="swiper-wrapper">
                    {% for item in component.blog_drop_list %}
                        <div class="swiper-slide flex items-center">
                            <div class="content_box px-7 py-0 sm:p-6 rounded-sm flex flex-col gap-2">
                                {% if component.sec_name %}
                                    <h2 class="text-[14px] font-normal leading-[18px]" style="color:{{component.base_color}};">
                                        {{ component.sec_name }}
                                    </h2>
                                {% endif %}
                                
                                {% if item.title %}
                                    <h3 class="text-[20px] sm:text-[28px] font-medium leading-[30px]" style="color:{{component.secondry_color}};"> 
                                        {{ item.title }}
                                    </h3>
                                {% endif %}
                                
                                <hr class="my-1 h-[2px] w-[286px]" style="background-color:{{component.base_color}};">
                                
                                <div class="dta_author flex items-center gap-4 text-sm" style="color:{{component.base_color}};">
                                    <div class="flex items-center gap-1">
                                        <i class="sicon-calendar-date"></i>
                                        <p class="date">{{ item.created_at|date("F Y") }}</p>
                                    </div>
                                    
                                    <div class="flex items-center gap-1">
                                        <i class="sicon-user"></i>
                                        {% if item.author.name %}
                                            <p class="date">{{ item.author.name }}</p>
                                        {% endif %}
                                    </div>
                                </div>
                                
                                {% if item.summary %}
                                    <p class="text-base font-normal" style="color:{{component.secondry_color}};">
                                        {{ item.summary }}
                                    </p>
                                {% endif %}
                                
                                <a href="{{ item.url }}" class="underline text-[18px] font-medium leading-[28px]" 
                                    style="color:{{component.base_color}};">
                                    {{ trans('blog.read_more') }}
                                </a>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
            
            <div class="swiper main-slider w-full {{ theme.settings.get('has_animation') ? 'Al__anime' }}" {% if theme.settings.get('has_animation') %} data-anim-allura="fade" data-dur-allura="1.0s" {% endif %}>
                <div class="swiper-wrapper">
                    {% for item in component.blog_drop_list %}
                        <div class="swiper-slide">
                            {% if item.image.url %}
                                <img src="{{ item.image.url }}" alt="{{ item.image.alt }}" 
                                    class="w-full h-96 object-cover rounded-sm">
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    var mainSlider = new Swiper(".main-slider", {
    
        spaceBetween: 20,
        slidesPerView: 1.3,
        breakpoints: {
            1024: { spaceBetween: 20, slidesPerView: 1.3 },
            768: { spaceBetween: 15, slidesPerView: 1 },
            480: { spaceBetween: 10, slidesPerView: 1 },
            350: { spaceBetween: 15, slidesPerView: 1.1 }
        }
    });

    var contentSlider = new Swiper(".content-slider", {
   
        spaceBetween: 10,
        slidesPerView: 1,
        autoHeight: true,
        on: {
            slideChangeTransitionStart: function () {
                document.querySelectorAll(".content-slider .swiper-slide .content_box").forEach(el => {
                    el.style.opacity = "0";
                    el.style.transform = "translateX(50px)";
                    el.style.transition = "opacity 0.5s ease-out, transform 0.5s ease-out";
                });
            },
            slideChangeTransitionEnd: function () {
                var activeSlide = document.querySelector(".content-slider .swiper-slide-active .content_box");
                if (activeSlide) {
                    activeSlide.style.opacity = "1";
                    activeSlide.style.transform = "translateX(0)";
                }
            }
        }
    });

    mainSlider.controller.control = contentSlider;
    contentSlider.controller.control = mainSlider;
</script>
