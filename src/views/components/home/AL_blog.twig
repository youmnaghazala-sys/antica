<section class="AL-blog ">
    <div class="container">
        <div class="flex items-center justify-between gap-6 py-12" style={{component.bg_color}}>
            <!-- سلايدر المحتوى -->
            <div class="swiper content-slider w-2/5">
                <div class="swiper-wrapper">
                    {% for item in component.blog_drop_list %}
                        <div class="swiper-slide flex items-center">
                            <div class="content_box p-6 shadow-md rounded-sm">
                                <h2 class="text-xl font-bold " style="color:{{component.base_color}};">
                                    {{ component.sec_name }}
                                </h2>
                                
                                <h3 class="text-lg font-semibold" style"color:{{component.secondry_color}};"> 
                                    {{ item.title }}
                                </h3>
                                
                                <hr class="my-2" style="color:{{component.base_color}};">
                                
                                <div class="dta_author flex items-center gap-4 text-sm" style="color:{{component.base_color}};">
                                    <div class="flex items-center gap-1">
                                        <i class="sicon-calendar-date"></i>
                                        <p class="date">{{ item.created_at|date("d F Y") }}</p>
                                    </div>
                                    <div class="flex items-center gap-1">
                                        <i class="sicon-user"></i>
                                        <p class="date">{{ item.author.name }}</p>
                                    </div>
                                </div>
                                
                                <p class=" mt-3" style="color:{{component.secondry_color}};">
                                    {{ item.summary }}
                                </p>
                                
                                <a href="{{ item.url }}" class="underline font-medium hover:text-blue-800" style="color:{{component.base_color}};">
                                    {{ trans('blog.read_more') }}
                                </a>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
            <!-- سلايدر الصور -->
            <div class="swiper main-slider w-3/5">
                <div class="swiper-wrapper">
                    {% for item in component.blog_drop_list %}
                        <div class="swiper-slide">
                            <img src="{{ item.image.url }}" alt="{{ item.image.alt }}" 
                                class="w-full h-80 object-cover rounded-sm shadow-md">
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</section>

<!-- استدعاء Swiper.js -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper/swiper-bundle.min.css">
<script src="https://cdn.jsdelivr.net/npm/swiper/swiper-bundle.min.js"></script>

<script>
    var mainSlider = new Swiper(".main-slider", {
        loop: true,
        spaceBetween: 20,
        slidesPerView: 1.3,
    });

    var contentSlider = new Swiper(".content-slider", {
        loop: true,
        spaceBetween: 10,
        slidesPerView: 1,
        autoHeight: true,
        on: {
            slideChangeTransitionStart: function () {
                document.querySelectorAll(".content-slider .swiper-slide .content_box").forEach(el => {
                    el.style.opacity = "0";
                    el.style.transform = "translateX(50px)";
                    el.style.transition = "opacity 0.5s ease-out, transform 0.5s ease-out";
                });
            },
            slideChangeTransitionEnd: function () {
                document.querySelector(".content-slider .swiper-slide-active .content_box").style.opacity = "1";
                document.querySelector(".content-slider .swiper-slide-active .content_box").style.transform = "translateX(0)";
            }
        }
    });

    // ربط السلايدر الأول بالثاني
    mainSlider.controller.control = contentSlider;
    contentSlider.controller.control = mainSlider;
</script>

<style>
    .AL-blog .content_box {
        opacity: 0;
        transform: translateX(50px);
        transition: opacity 0.5s ease-out, transform 0.5s ease-out;
    }

    .AL-blog .content-slider .swiper-slide-active .content_box {
        opacity: 1;
        transform: translateX(0);
    }
      .AL-blog .main-slider {
        width: 60%;
        max-width: 800px;
        margin:0 ;
    }

    .AL-blog .content-slider {
        width: 40%;
        max-width: 320px;
    }

</style>
