<section class="AL-blog py-6">
    <div class="container">
        <div class="flex items-center justify-between flex-col sm:flex-row gap-6 py-12" style="background-color:{{component.bg_color}};">
            <div class="swiper content-slider ">
                <div class="swiper-wrapper">
                    {% for item in component.blog_drop_list %}
                        <div class="swiper-slide flex items-center">
                            <div class="content_box p-6 rounded-sm flex flex-col gap-2">
                                {% if component.sec_name %}
                                    <h2 class="text-[14px] font-normal leading-[18px]" style="color:{{component.base_color}};">
                                        {{ component.sec_name }}
                                    </h2>
                                {% endif %}
                                
                                {% if item.title %}
                                    <h3 class="text-[28px] font-medium leading-[42px]" style"color:{{component.secondry_color}};"> 
                                        {{ item.title }}
                                    </h3>
                                {% endif %}
                                
                                <hr class="my-2 h-[2px] w-[286px]" style="background-color:{{component.base_color}};">
                                
                                <div class="dta_author flex items-center gap-4 text-sm" style="color:{{component.base_color}};">
                                    <div class="flex items-center gap-1">
                                        <i class="sicon-calendar-date"></i>
                                        <p class="date">{{ item.created_at|date("F Y") }}</p>
                                    </div>
                                    
                                    <div class="flex items-center gap-1">
                                        <i class="sicon-user"></i>
                                        {% if  item.author.name  %}
                                            <p class="date">{{ item.author.name }}</p>
                                        {% endif %}
                                    </div>
                                </div>
                                
                                {% if item.summary %}
                                    <p class="text-base font-normal " style="color:{{component.secondry_color}};">
                                        {{ item.summary }}
                                    </p>
                                {% endif %}
                                
                                <a href="{{ item.url }}" class="underline text-[18px] font-medium leading-[28px]" 
                                    style="color:{{component.base_color}};">
                                    {{ trans('blog.read_more') }}
                                </a>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
            <!-- سلايدر الصور -->
            <div class="swiper main-slider w-full">
                <div class="swiper-wrapper">
                    {% for item in component.blog_drop_list %}
                        <div class="swiper-slide">
                            <img src="{{ item.image.url }}" alt="{{ item.image.alt }}" 
                                class="w-full h-96 object-cover rounded-sm">
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</section>


<script>
    var mainSlider = new Swiper(".main-slider", {
        loop: true,
        spaceBetween: 20,
        slidesPerView: 1.3,
        breakpoints: {
            1024: { // لابتوب وأجهزة كبيرة
                spaceBetween: 20,
                slidesPerView: 1.3
            },
            768: { // تابلت وأجهزة متوسطة
                spaceBetween: 15,
                slidesPerView: 1
            },
            480: { // موبايل صغير
                spaceBetween: 10,
                slidesPerView: 1
            },
            350: { // موبايل صغير
                spaceBetween: 10,
                slidesPerView: 1
            }
    }
    });

    var contentSlider = new Swiper(".content-slider", {
        loop: true,
        spaceBetween: 10,
        slidesPerView: 1,
        autoHeight: true,
        on: {
            slideChangeTransitionStart: function () {
                document.querySelectorAll(".content-slider .swiper-slide .content_box").forEach(el => {
                    el.style.opacity = "0";
                    el.style.transform = "translateX(50px)";
                    el.style.transition = "opacity 0.5s ease-out, transform 0.5s ease-out";
                });
            },
            slideChangeTransitionEnd: function () {
                document.querySelector(".content-slider .swiper-slide-active .content_box").style.opacity = "1";
                document.querySelector(".content-slider .swiper-slide-active .content_box").style.transform = "translateX(0)";
            }
        }
    });

    // ربط السلايدر الأول بالثاني
    mainSlider.controller.control = contentSlider;
    contentSlider.controller.control = mainSlider;
</script>


