<section class="special_title my-5">
	<div class="wrapper container mx-auto flex flex-col items-center justify-center">
		{% if component.section_title %}
			<p class="text-sm font-normal {{ theme.settings.get('has_animation') ? 'Al__anime' }}" {% if theme.settings.get('has_animation') %} data-anim-allura="fade" data-dur-allura="0.4s" {% endif %} style="color: {{ component.section_title_color }};">{{ component.section_title }}</p>
		{% endif %}
		
		{% if component.main_text %}
			<h3 class="relative w-fit mt-1 mb-3 pb-1 text-xl md:text-[28px] font-bold leading-[48px] {{ theme.settings.get('has_animation') ? 'Al__anime' }}" {% if theme.settings.get('has_animation') %} data-anim-allura="fade" data-dur-allura="0.6s" {% endif %} style="color: {{ component.main_text_color }};">{{ component.main_text }}</h3>
		{% endif %}
		
		{% if component.sub_text %}
			<h5 class="text-sm md:text-base font-normal {{ theme.settings.get('has_animation') ? 'Al__anime' }}" {% if theme.settings.get('has_animation') %} data-anim-allura="fade" data-dur-allura="0.8s" {% endif %} style="color: {{ component.sub_text_color }};">{{ component.sub_text }}</h5>
		{% endif %}
	</div>
</section>
<style>
	{% if component.enable_border %}
		.special_title h3::after {
			content: "";
			position: absolute;
			bottom: -1px;
			left: 0;
			right: 0;
			width: 100%;
			height: 2px;
			background-color: {{component.border_color}};
		}
	{% endif %}
</style>