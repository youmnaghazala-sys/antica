<section class="special_title my-5">
	<div class="wrapper container mx-auto flex flex-col items-center justify-center">
		<p class="text-sm font-normal" style="color: {{ component.section_title_color }};">{{ component.section_title }}</p>
		<h3 class="relative w-fit text-[24px] font-bold leading-[48px]" style="color: {{ component.main_text_color }};">{{ component.main_text }}</h3>
		<h5 class="text-base font-normal" style="color: {{ component.sub_text_color }};">{{ component.sub_text }}</h5>
	</div>
</section>
<style>
	{% if component.enable_border %}
		.special_title h3::after {
			content: "";
			position: absolute;
			bottom: -1px;
			left: 0;
			right: 0;
			width: 100%;
			height: 2px;
			background-color: {{component.border_color}};
		}
	{% endif %}
</style>