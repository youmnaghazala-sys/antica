<section class="al-categories my-10">
    <div class="container">
        {% if component.is_slider %}
        <salla-slider id="thumbs"
            show-controls="false"
            type="thumbs" slider-config='{
            "slidesPerView": 2,
            "spaceBetween": 10,
            "centerInsufficientSlides": true,
            "breakpoints": {
                "320": { "slidesPerView": 2 },
                "768": { "slidesPerView": 4 },
                "1024": { "slidesPerView": 6 }
            }
        }'>
            <div slot="items">
        {% else %}
            <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-6">
        {% endif %}
                    {% for category in component.category %}
                        <a href="{{category.category_url}}" style="--background:{{category.background_color}} ; --background_hover:{{category.background_hover_color}}5d" class="category_card mb-5 md:mb-0 {{ theme.settings.get('has_animation') ? 'Al__anime' }}" {% if theme.settings.get('has_animation') %} data-anim-allura="fade" data-dur-allura="0.{{loop.index +2}}s" {% endif %}>
                            {% if category.category_image %}
                                <img src="{{category.category_image}}" class="-translate-y-1/3" alt="">
                            {% endif %}
                            {% if category.category_name_color %}
                                <h3 style="color:{{category.category_name_color}}" class="text-2xl text-center">{{category.category_name}}</h3>
                            {% endif %}
                            {% if category.category_num_color %}
                                <p style="color:{{category.category_num_color}}" class="text-base">{{category.category_num}} {{trans('common.peice')}}</p>
                            {% endif %}
                        </a>
                    {% endfor %}
            {% if component.is_slider %}
                </div>
                </salla-slider>
            {% else %}
                </div>
            {% endif %}
    </div>
</section>

<style>
    .al-categories .container{
        overflow-x: clip;
    }
    .al-categories .swiper{
        height: 232px !important;
        overflow: unset;
    }
    .al-categories img{
        width: 95%;
        height: 141px;
        scale: 1;
        transition: 1s all;
    }
    .al-categories .category_card{
        background: var(--background);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        transition: 1s all;
        transform: scale(1);
    }
    .al-categories .category_card:hover{
        background: var(--background_hover);
        transform: scale(0.9);
    }
    .al-categories .category_card:hover img{
        scale: 1.2;
    }
    .al-categories .s-slider-v-centered .s-slider-block__title-nav{
        left: 13% !important;
        top: -20% !important;
    }
</style>