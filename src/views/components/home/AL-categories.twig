<section class="al-categories my-10">
    <div class="container">
        {% if component.is_slider %}
            <salla-slider id="thumbs"
                show-controls="false"
                type="thumbs" 
                slider-config='{
                    "slidesPerView": 2,
                    "spaceBetween": 10,
                    "centerInsufficientSlides": true,
                    "breakpoints": {
                        "320": { "slidesPerView": 2 ,"spaceBetween": 18 },
                        "768": { "slidesPerView": 4 ,"spaceBetween": 15 },
                        "1024": { "slidesPerView": 6 , "spaceBetween": 10 }
                    }
                }'>
                <div slot="items">
        {% else %}
            <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-x-2 gap-y-12 md:gap-x-6 md:gap-y-20">
        {% endif %}
                    {% for category in component.category %}
                        <a href="{{category.category_url}}" style="--background:{{category.background_color}} ; --background_hover:{{category.background_hover_color}}5d" class="category_card mb-5 md:mb-10 {{ theme.settings.get('has_animation') ? 'Al__anime' }}" {% if theme.settings.get('has_animation') %} data-anim-allura="fade" data-dur-allura="0.{{loop.index +2}}s" {% endif %}>
                            {% if category.category_image %}
                                <img src="{{ category.category_image }}" class="-translate-y-[15%] md:-translate-y-1/3" alt="">
                            {% endif %}
                            
                            {% if category.category_name %}
                                <h3 style="color: {{ category.category_name_color }}" class="font-medium text-xl md:text-2xl text-center">{{category.category_name}}</h3>
                            {% endif %}
                            
                            {% if category.category_num %}
                                <p style="color: {{category.category_num_color}}" class="text-sm md:text-base mb-1">{{category.category_num}} {{trans('common.peice')}}</p>
                            {% endif %}
                        </a>
                    {% endfor %}
            {% if component.is_slider %}
                </div>
                </salla-slider>
            {% else %}
                </div>
            {% endif %}
    </div>
</section>

<style>
    .al-categories .container{
        overflow-x: clip;
    }
    .al-categories .swiper{
        height: 232px !important;
        overflow: unset;
        @media (max-width: 768px) {
            height: 170px !important;
        }
    }
    .al-categories img {
        width: 90%;
        height: 135px;
        scale: 1;
        transition: 1s all;
    }
    .al-categories .category_card {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        transform: scale(1);
    }
    .al-categories .category_card::after {
        content: '';
        position: absolute;
        inset: 0;
        background: var(--background);
        transition: .7s all;
        z-index: -1;
    }
    .al-categories .category_card:hover::after {
        background: var(--background_hover);
        transform: scale(0.85);
    }
    .al-categories .category_card:hover img {
        scale: 1.1;
    }
    .al-categories .s-slider-v-centered .s-slider-block__title-nav{
        left: 13% !important;
        top: -20% !important;
    }
</style>