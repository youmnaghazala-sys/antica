<section class="al-categories">
    <div class="container">
        {% if component.is_slider %}
            <salla-slider id="thumbs" show-controls="true" type="thumbs" slider-config='{
                "slidesPerView": 6,
                "spaceBetween": 10,
                "centerInsufficientSlides": true
                }'>
            <div slot="items">
        {% else %}
            <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-6">
        {% endif %}
                    {% for category in component.category %}
                        <a href="category.category_url" style="--background:{{category.background_color}} ; --background_hover:{{category.background_hover_color}}5d" class="category_card">
                            {% if category.category_image %}
                                <img src="{{category.category_image}}" class="-translate-y-5" alt="">
                            {% endif %}
                            {% if category.category_name_color %}
                                <h3 style="color:{{category.category_name_color}}">{{category.category_name}}</h3>
                            {% endif %}
                            {% if category.category_num_color %}
                                <p style="color:{{category.category_num_color}}">{{category.category_num}} {{trans('common.peice')}}</p>
                            {% endif %}
                        </a>
                    {% endfor %}
            {% if component.is_slider %}
                </div>
                </salla-slider>
            {% else %}
                </div>
            {% endif %}

    </div>
</section>

<style>
    .al-categories{

    }
    .al-categories .category_card{
        background: var(--background);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        transition: 0.5s all ;
    }
    .al-categories .category_card:hover{
        background: var(--background_hover);
    }
</style>