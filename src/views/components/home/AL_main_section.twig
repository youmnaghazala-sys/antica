{% set c = component %}

<section class="Alo__main">
	<salla-slider id="main-slider-{{ position }}" auto-play type="fullwidth" show-controls="false">
		<div slot="items">
			{% for i in c.slider_images %}
				<div class="swiper-slide {{ theme.settings.get('has_animation') ? 'Al__anime' }}" {% if theme.settings.get('has_animation') %} data-anim-allura="fade" data-dur-allura="0.{{loop.index +2}}s" {% endif %}>
					<div class="flex flex-wrap lg:flex-nowrap h-[535px] md:h-[700px] ">
						<div class="img hidden md:block lg:w-1/3 w-1/2 spacespacespace h-[353px] md:h-[700px]" data-after-color="{{ i.background_color }}">
							<img src="{{i.main_image}}" alt="{{i.title}}" class="object-cover w-full h-[353px] md:h-[700px] ">
						</div>
						<div class="lg:hidden block lg:w-1/3 w-full spacespacespace h-[353px] md:h-[700px]" data-after-color="{{ i.background_color }}">
							<img src="{{i.secondary_image}}" alt="{{i.title}}" class="object-cover w-full h-[353px] md:h-[700px]">
						</div>
						<div class=" lg:w-1/3 w-full flex flex-center flex-col lg:gap-10 gap-6 px-3 pb-14" style="background-color: {{i.background_color}};">
							{% if i.show_logo %}
								<div class="mt-6 lg:mt-0 max-w-24 sm:max-w-32 lg:max-w-44"><img src="{{store.logo}}" alt="{{store.name}}"></div>
							{% endif %}
							<div class="text-center flex-center flex-col gap-2">
								<h1 class="text-2xl sm:text-xl lg:text-[40px] !leading-12" style = "color: {{i.main_text_color}};">{{i.title}}</h1>
								<p class="text-lg sm:text-xl lg:text-2xl" style = "color: {{i.sub_text_color}};">{{i.subtitle}}</p>
							</div>
							<div class="">
								{% include 'components.custom.button' with {'btn_txt': i.button_text, 'btn_url': i.url, 'btn_bg': i.text_color, 'btn_color': i.background_color } %}
								{# {% include 'components.custom.button' with {'btn_txt': c.btn_txt,'btn_url': c.btn_url, 'btn_bg':c.btn_bg, 'btn_color':c.btn_color } %} #}
							</div>
						</div>
						<div class="lg:block hidden lg:w-1/3 w-1/2 spacespacespace h-full" data-after-color="{{ i.background_color }}"><img src="{{i.secondary_image}}" alt="{{i.title}}" class="object-cover w-full h-full"></div>
					</div>
				</div>
			{% endfor %}
		</div>
	</salla-slider>
</section>

<script>

	document.querySelectorAll('.swiper-slide').forEach(slide => {
slide.addEventListener('mouseenter', () => {
slide.querySelectorAll('.spacespacespace').forEach(el => {
const color = el.getAttribute('data-after-color');
el.style.setProperty('--after-color', color);
});
});
});
</script>

