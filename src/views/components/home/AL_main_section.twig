<section class="Alo__main">
	<salla-slider id="main-slider-{{ position }}" type="fullwidth" show-controls="false" pagination="true" slider-config='{"centeredSlides": true}'>
		<div slot="items">
			{% for i in component.slider_images %}
				<div class="swiper-slide {{ theme.settings.get('has_animation') ? 'Al__anime' }}" {% if theme.settings.get('has_animation') %} data-anim-allura="fade" data-dur-allura="0.{{loop.index +2}}s" {% endif %}>
					<div class="flex flex-wrap lg:flex-nowrap min-h-[700px] md:h-[700px]" {% if i.background_color %} style="background-color: {{ i.background_color }};" {% endif %}>
						<div class="img hidden md:block lg:w-1/3 w-1/2 spacespacespace h-[353px] md:h-[700px]" data-after-color="{{ i.background_color }}">
							{% if i.main_image %}
								<img src="{{i.main_image}}" alt="{{i.title}}" class="object-cover w-full h-[353px] md:h-[700px] ">
							{% endif %}
						</div>

						{% if i.secondary_image %}
							<div class="lg:hidden block lg:w-1/3 w-full spacespacespace h-[353px] md:h-[700px]" data-after-color="{{ i.background_color }}">
								<img src="{{i.secondary_image}}" alt="{{i.title}}" class="object-cover w-full h-[353px] md:h-[700px]">
							</div>
						{% endif %}

						<div class=" lg:w-1/3 w-full flex flex-center flex-col lg:gap-10 gap-6 px-3 pb-14">
							{% if i.show_logo %}
								<div class="mt-6 lg:mt-0 max-w-24 sm:max-w-32 lg:max-w-44"><img src="{{store.logo}}" alt="{{store.name}}"></div>
							{% endif %}

							{% if i.title or i.subtitle %}
								<div class="text-center flex-center flex-col gap-2">
									{% if i.title %}
										<h1 class="text-2xl sm:text-xl lg:text-[40px] !leading-12" style="color: {{ i.maintext_color }};">{{i.title}}</h1>
									{% endif %}

									{% if i.subtitle %}
										<p class="text-lg sm:text-xl lg:text-2xl" style="color: {{ i.subtext_color }};">{{i.subtitle}}</p>
									{% endif %}
								</div>
							{% endif %}

							{% if i.button_text %}
								<div>
									{% include 'components.custom.button' with {'btn_txt': i.button_text, 'btn_url': i.url, 'btn_bg': i.button_color, 'btn_color': i.button_text_color } %}
								</div>
							{% endif %}
						</div>

						{% if i.secondary_image %}
							<div class="lg:block hidden lg:w-1/3 w-1/2 spacespacespace h-full" data-after-color="{{ i.background_color }}">
								<img src="{{ i.secondary_image }}" alt="{{ i.title }}" class="object-cover w-full h-full">
							</div>
						{% endif %}
					</div>
				</div>
			{% endfor %}
		</div>
	</salla-slider>
</section>

<style>
	.Alo__main salla-slider .swiper-pagination {
		.swiper-pagination-bullet {
			width: 13px;
			height: 13px;
			border-radius: 50%;
			background-color: rgb(53 65 43 / 28%);
			opacity: 1;
			outline: 1px solid rgb(53 65 43 / 28%);
		}
		.swiper-pagination-bullet-active {
			background-color: var(--color-primary);;
			outline: 1px solid var(--color-primary);;
			border: 2px solid transparent; 
			width: 16px;
			height: 16px;
		}
	}
</style>

<script>
	document.querySelectorAll('.swiper-slide').forEach(slide => {
		slide.addEventListener('mouseenter', () => {
		slide.querySelectorAll('.spacespacespace').forEach(el => {
			const color = el.getAttribute('data-after-color');
			el.style.setProperty('--after-color', color);
			});
		});
	});
</script>