{% set c = component %}
<section id="AL_best_seller-{{ position }}" class="AL_best_seller mb-5 pb-12" style="background-color: {{ c.section_bgcolor }}">
    <div class="background container relative !overflow-hidden">
        {% if c.bg_video %}
            <div class="video-background w-full h-[580px] relative Al__anime" data-anim-allura="fade" data-dur-allura="0.8s">
                <video id="background-video-{{ position }}" autoplay muted loop playsinline class="w-full h-full object-cover">
                    <source src="{{ c.video_url }}" type="video/mp4">
                    Your browser does not support the video tag.
                </video>
                
                <div class="video-controls absolute top-4 right-4">
                    <button id="toggle-video-button-{{ position }}" class="bg-white opacity-55 text-black px-2 pb-1 pt-2 rounded-full">
                        <i class="sicon-pause"></i>
                    </button>
                </div>
            </div>
        {% else %}
            <div class="image-div w-full h-[580px] Al__anime" data-anim-allura="fade" data-dur-allura="0.8s">
                {% if c.bg_image %}
                    <img src="{{ c.bg_image }}" alt="Background Image" class="w-full h-full object-cover">
                {% endif %}
            </div>
        {% endif %}
        <div id="products-{{ position }}" class="products w-[97%] absolute bottom-[15%] -translate-x-[0%] md:-translate-x-[87.5%]">
            <salla-slider id="thumbs" show-controls="false" type="thumbs" slider-config='{
                "autoplay": {
                    "delay": 3000
                },
                "slidesPerView": 3,
                "spaceBetween": 10,
                "breakpoints": {
                    "320": { "slidesPerView": 1 },
                    "768": { "slidesPerView": 1.8 },
                    "1024": { "slidesPerView": 3 }
                }
            }'>

        <div id="products-{{ position }}" class="products w-[90%] absolute bottom-[15%] -translate-x-[0%] md:-translate-x-[87.5%]">
            <salla-slider id="thumbs" show-controls="false" type="thumbs" slider-config='{"autoplay": {"delay": 3000}, "slidesPerView": 3, "spaceBetween": 10, "breakpoints": {"320": {"slidesPerView": 1}, "768": {"slidesPerView": 1.8}, "1024": {"slidesPerView": 3}}}'>

                <div slot="items">
                    {% for product in c.best_sell_products %}
                        <custom-salla-product-card product="{{ product }}"></custom-salla-product-card>
                    {% endfor %}
                </div>
            </salla-slider>
        </div>
    </div>
</section>

<style>
    .AL_best_seller .products custom-salla-product-card {
        height: 178px;
        display: flex !important;
        border-radius: 0;
    }
    .AL_best_seller .products custom-salla-product-card .s-product-card-image {
        border-top-right-radius: 0;
        border-bottom-right-radius: 0;
        width: 40%;
        background-color: #fff;
    }
    .AL_best_seller .products custom-salla-product-card .s-product-card-content {
        justify-content: center;
        margin: auto;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll("custom-salla-product-card").forEach(card => {
            card.classList.replace("s-product-card-vertical", "s-product-card-horizontal");
        });

        const productsContainer = document.querySelector("#products-{{ position }}");
        const section = document.querySelector("#AL_best_seller-{{ position }}");

            if (sectionPosition < screenHeight * 0.75) {
                if (window.innerWidth > 768) { // For large screens
                    productsContainer.style.transform = "translateX(-1%)";
                    productsContainer.style.transition = "transform 6s linear";
                }
        function handleScroll() {
            if (section.getBoundingClientRect().top < window.innerHeight * 0.75 && window.innerWidth > 768) {
                productsContainer.style.transform = "translateX(-5%)";
                productsContainer.style.transition = "transform 6s linear";
            }
        }
        window.addEventListener("scroll", handleScroll);
        handleScroll();

        const video = document.querySelector("#background-video-{{ position }}");
        const toggleButton = document.querySelector("#toggle-video-button-{{ position }}");

        if (video && toggleButton) {
            toggleButton.addEventListener("click", () => {
                video.paused ? video.play() : video.pause();
                toggleButton.innerHTML = `<i class="sicon-${video.paused ? 'play' : 'pause'}"></i>`;
            });
        }
    });
</script>
