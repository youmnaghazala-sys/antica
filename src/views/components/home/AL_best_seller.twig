{% set c = component %}
<section id = "AL_best_seller-{{ position }}" class="AL_best_seller mb-5 pb-12" style="background-color : {{c.section_bgcolor}}">  
    <div class="background container relative !overflow-hidden ">

        {% if c.bg_video %}
            <div class="video-background w-full h-[580px] relative Al__anime" data-anim-allura="fade" data-dur-allura="0.8s">
                <video id="background-video-{{ position }}" autoplay muted loop playsinline class="w-full h-full object-cover">
                    <source src="{{ c.video_url }}" type="video/mp4"/>
                    Your browser does not support the video tag.
                </video>
                <div class="video-controls absolute top-4 right-4">
                    <button id="toggle-video-button-{{ position }}" class="bg-white opacity-55 text-black md:px-[10px] md:pb-[4px] md:pt-[7px] rounded-full w-[24px] h-[24px] md:h-[48px] md:w-[48px]">
                        <i class="sicon-pause text-[13px] md:text-[21px]"></i> 
                    </button>
                </div>
            </div>
        {% else %}
            <div class="image-div w-full h-[580px] Al__anime" data-anim-allura="fade" data-dur-allura="0.8s">
                <img src="{{ c.bg_image }}" alt="Background Image" class="w-full h-full object-cover">
            </div>
        {% endif %}
        <div id="products-{{ position }}" class="products w-[93%] md:w-[97%] absolute bottom-[15%] -translate-x-[0%] md:-translate-x-[87.5%]">
            <salla-slider id="thumbs" show-controls="false" type="thumbs" slider-config='{
                "autoplay": {
                    "delay": 3000
                },
                "slidesPerView": 3,
                "spaceBetween": 10,
                "breakpoints": {
                    "320": { "slidesPerView": 1 },
                    "768": { "slidesPerView": 1 },
                    "1024": { "slidesPerView": 3 }
                }
            }'>
                <div slot="items">
                    {% for product in c.best_sell_products %}
                        <custom-salla-product-card horizontal product="{{ product }}"></custom-salla-product-card>
                    {% endfor %}
                </div>
            </salla-slider>
        </div>
    </div>
</section>

<style>
    .AL_best_seller .products custom-salla-product-card {
        height: 178px;
        display: flex !important;
        border-radius: 0;
    }
    @media(max-width:768px){
        .AL_best_seller .products custom-salla-product-card {
            height: 151px;
            width:326px !important;
    }
    }
    .AL_best_seller .products custom-salla-product-card .s-product-card-image  {
        border-top-right-radius: 0;
        border-bottom-right-radius: 0;
        width: 40%;
    }
    
    .AL_best_seller .products custom-salla-product-card .s-product-card-content {
        justify-content: center;
        margin: auto;
    }
    .AL_best_seller .products custom-salla-product-card .s-product-card-image img {
        background-color: #fff;
    }
    
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
       
        const productsContainer = document.querySelector("#products-{{ position }}");
        
        function handleScroll() {
            const section = document.querySelector("#AL_best_seller-{{ position }}");
            const sectionPosition = section.getBoundingClientRect().top;
            const screenHeight = window.innerHeight;

            if (sectionPosition < screenHeight * 0.75) {
                if (window.innerWidth > 768) { 
                    productsContainer.style.transform = "translateX(-1%)";
                    productsContainer.style.transition = "transform 6s linear";
                }
            }
        }

        window.addEventListener("scroll", handleScroll);
        handleScroll(); 

        const video = document.querySelector("#background-video-{{ position }}");
        const toggleButton = document.querySelector("#toggle-video-button-{{ position }}");

        if (video && toggleButton) {
            toggleButton.addEventListener("click", () => {
                if (video.paused) {
                    video.play();
                    toggleButton.innerHTML = '<i class="sicon-pause"></i>'; 
                } else {
                    video.pause();
                    toggleButton.innerHTML = '<i class="sicon-play"></i>'; 
                }
            });

            if (video.paused) {
                toggleButton.innerHTML = '<i class="sicon-pause"></i>';
            } else {
                toggleButton.innerHTML = '<i class="sicon-play"></i>';
            }
        }
        
        let iconElements = document.querySelectorAll(".text-base.sicon-shopping-bag");

        iconElements.forEach(icon => {
            icon.classList.replace("sicon-shopping-bag", "sicon-cart2");
        });
    
    });
</script>