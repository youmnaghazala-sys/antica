<footer class="store-footer bg-no-repeat bg-cover" style="{% if theme.settings.get('is_footer_bg_image') %}background-image:url({{theme.settings.get('footer_bg_img')}}); {% else %} background-color:{{theme.settings.get('footer_bg_color')}}{% endif %}">

	<div
		aria-label="footer" class="store-footer__inner text-footercolor !bg-transparent !pt-8">
		{# ================ newsletter=============== #}
		{% if theme.settings.get('has_newsletter') %}
			<div class="container flex flex-col sm:flex-row sm:items-center gap-7 pb-5 md:pb-12 border-b border-solid  border-[#0000001a]">
				<h1 class="text-lg md:text-2xl font-medium whitespace-nowrap">{{ trans('pages.cart.newlettert')}}</h1>
				<form class="flex bg-white rounded-sm p-1.5 md:p-2 w-full items-center">
					<input type="email" placeholder="{{ trans('pages.cart.email')}}" required class="w-full border-none focus:outline-none placeholder:text-xxs sm:placeholder:text-base placeholder:text-gray-400 rounded-sm"/>
					<a href="{{theme.settings.get('newsletter_action')}}" class="!my-0 !py-0">
						<i class="sicon-send-mail block rotate-[224deg] text-xxs md:text-base text-white bg-footercolor rounded-full p-1.5 md:p-2 "></i>
					</a>
				</form>
				<div class="flex gap-2 md:gap-3">
					<div class="flex items-center rounded-sm p-2 md:p-4 gap-3 md:gap-7 border border-solid border-[#20202007]" style="backdrop-filter: contrast(0.9);">
						<i class="sicon-phone-talking text-base md:text-2xl text-white bg-footercolor rounded-full p-1.5 md:p-3"></i>
						<div>
							<p class="text-xs md:text-lg">{{trans('pages.cart.contactus')}}</p>
							<p>{{store.contacts.phone }}</p>
						</div>
					</div>

					<div class="flex items-center rounded-sm border border-solid border-[#20202007] p-2 md:p-4 gap-3 md:gap-7" style="backdrop-filter: contrast(0.9);">
						<i class="sicon-mail text-base md:text-2xl text-white bg-footercolor rounded-full p-1.5 md:p-3"></i>
						<div>
							<p class="text-xs md:text-lg">{{trans('pages.cart.sendus')}}</p>
							<p>{{store.contacts.email }}</p>
						</div>
					</div>
				</div>
			</div>
		{% endif %}
		<div class="container grid grid-col-2 md:grid-cols-6 gap-4 lg:gap-11 mt-5 md:mt-8">
			<div class="col-span-2 rtl:lg:pl-11 ltr:lg:pr-11 border-b md:border-b-0 md:border-l border-solid  border-[#0000001a] pb-4 md:pb-0">
				<a href="{{ link('/') }}" class="flex items-center m-0 max-w-16 md:max-w-[90px]">
					<img src="{{store.logo}}" alt="{{store.name}}" width="100%">
				</a>
				{% if store.description %}
					<div class="mb-2.5 text-base md:text-lg leading-8 mt-2.5 md:mt-3.5">
						<p class="max-w-sm ">
							{{ store.description|raw }}
						</p>
					</div>
				{% endif %}

				<div>
					<salla-social></salla-social>
				</div>

				{# vat #}
				{% if store.settings.tax.number %}
					<div class="flex rtl:space-x-reverse space-x-2 items-end">
						{% if store.settings.tax.certificate %}
							<a class="load-img-onclick" data-modal-id="modal-value-tax" href="#/" alt="{{ store.settings.tax.number }}">
								<img width="100%" height="100%" src="{{ 'images/s-empty.png' | cdn }}" data-src="{{'images/tax.png' | cdn(70,70)}}" class="lazy w-10 rounded-sm hover:opacity-80 transition-opacity" alt="value added tax">
							</a>
						{% endif %}
						<div>
							<p class="text-sm text-text-grey mb-1">{{ trans('common.elements.tax_number') }}</p>
							<b class="text-sm">{{ store.settings.tax.number }}</b>
						</div>
					</div>

					{% if store.settings.tax.certificate %}
						<salla-modal sub-title-first sub-title="{{ trans('common.elements.tax_number') }}" modal-title="{{ store.settings.tax.number }}" id="modal-value-tax">
							<div class="flex justify-center max-w-full">
								<img class="w-full" loading="lazy" src="{{ 'images/s-empty.png' | cdn }}" data-src="{{ store.settings.tax.certificate }}" alt="{{ store.settings.tax.number }}"/>
							</div>
						</salla-modal>
					{% endif %}
				{% endif %}
			</div>

			<div class="col-span-2 md:col-span-1 border-b md:border-b-0 md:border-l border-solid  border-[#0000001a] pb-4 md:pb-0">
				<h3>{{ trans('blocks.footer.pages_links') }}</h3>
				<salla-menu source="footer"></salla-menu>
			</div>

			<div class="">
				<salla-contacts></salla-contacts>
			</div>
			<div class="verification flex flex-col items-center text-center gap-1 mt-6 md:mt-5 md:border-r border-solid  border-[#0000001a]">
				<div id="new-location"></div>
				<p class="text-sm md:text-base font-normal text-footercolor">{{trans('pages.cart.verification')}}</p>
			</div>
			<salla-apps-icons class="lg:col-span-2 rtl:lg:pr-20 ltr:lg:pl-20"></salla-apps-icons>

		</div>
	</div>

	<div class="md:flex items-center justify-between py-4 container text-center">
		<span class="text-sm copyright-text">{% hook copyright %}</span>
		<salla-payments class="salla-payments_footer"></salla-payments>
	</div>
</div>

<span class="hidden bottom-2 rtl:pl-24 ltr:pr-24 md:grid-cols-3 opacity-40"></span></footer><style>
@media(max-width:768px) {
	.store-footer {
		{% if theme.settings.get('is_footer_bg_image') and theme.settings.get('footer_bg_img_sm') %}
			background-image: url({{theme.settings.get('footer_bg_img_sm')}}) !important;
		{% else %}
			background-color: {{theme.settings.get('footer_bg_color')}}
		{% endif %}
	}
}</style>

