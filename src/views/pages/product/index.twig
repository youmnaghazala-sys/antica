					</div>

					<div class="flex items-center space-x-2 rtl:space-x-reverse">
						{% if filters %}
							<a href="#filters-menu" class="filters-trigger bg-border-color text-primary lg:hidden mt-2">
								<i class="sicon-filter text-gray-text text-2xl me-2.5"></i>
							</a>
						{% endif %}
						{% if sort_options|length %}
							<div class="flex items-center">
								<select id="product-filter" class="form-input pt-0 pb-1 rtl:md:pl-10 ltr:md:pr-10 text-[#666] text-[18px] font-normal">
									{% for sort in sort_options %}
										<option value="{{ sort.id }}" {{ sort.is_selected ? 'selected' : '' }}>
											ال{{ trans('pages.categories.sorting') }}:
											{{ sort.name }}
										</option>
									{% endfor %}
								</select>
							</div>
						{% endif %}
					</div>
				</div>

				{% hook 'product:index.items.start' %}
				<div class="flex min-h-screen">
					<salla-products-list class="flex-1 min-w-0 overflow-auto" source="{{ page.slug }}" source-value="{{ page.id }}" {{ filters ?'filters-Results':'' }}></salla-products-list>
				</div>
				{% hook 'product:index.items.end' %}
			</div>
		</div>
	</div>
	{% if store.settings.category.testimonial_enabled %}
		{% component 'home.testimonials' %}
	{% endif %}
	<div id="index-followus-wrapper"></div>
{% endblock %}
{% block scripts %}
	<script defer src="{{ 'product.js' | asset }}"></script>

	<script defer>
	function handleSVGClick(event) {
		// Reset all SVGs to default state
		const svgs = document.querySelectorAll('#icons_wrapper svg');
		svgs.forEach(svg => {
		// Reset background and border radius
		svg.style.background = 'transparent';
		svg.style.borderRadius = '0';

		// Reset paths
		const paths = svg.querySelectorAll('path');
		paths.forEach(path => {
			path.setAttribute('fill', 'var(--color-primary)');
			path.setAttribute('fill-opacity', '0.4');
		});
		});

		// Style the clicked SVG
		const clickedSVG = event.currentTarget;
		clickedSVG.style.background = 'var(--color-primary)';
		clickedSVG.style.borderRadius = '50%';

		// Make paths white
		const paths = clickedSVG.querySelectorAll('path');
		paths.forEach(path => {
		path.setAttribute('fill', 'white');
		path.setAttribute('fill-opacity', '1');
		});
	}

	document.addEventListener('DOMContentLoaded', () => {
		const svgs = document.querySelectorAll('#icons_wrapper svg');
		svgs.forEach(svg => {
		svg.removeEventListener('click', handleSVGClick);
		svg.addEventListener('click', handleSVGClick);
		});
	});
	</script>

	<script defer>
	function formatCols(isAdd, element) {
		const resultsDiv = document.querySelector('.main-content .s-products-list-wrapper');
		const allToggles = document.querySelectorAll('.viewToggle');
		const horizontalCards = document.querySelectorAll('.main-content .s-products-list-wrapper custom-salla-product-card');

		// Reset all toggle icons
		allToggles.forEach(toggle => {
		const path = toggle.querySelector('path');
		if (path) {
			path.setAttribute('fill-opacity', '0.4');
		}
		});

		// Highlight selected toggle
		const selectedPath = element.querySelector('path');
		if (selectedPath) {
		selectedPath.setAttribute('fill-opacity', '1');
		}

		// Get selected column layout
		const columns = element.getAttribute('data');

		// Reset cards to vertical by default
		horizontalCards.forEach(card => {
			card.classList.remove('s-product-card-horizontal');
			card.classList.add('s-product-card-vertical');
		});

		// Apply selected layout
		switch (columns) {
		case 'one':
			resultsDiv.style.gridTemplateColumns = '1fr';
			horizontalCards.forEach(card => {
				card.classList.add('s-product-card-horizontal');
				card.classList.remove('s-product-card-vertical');
			});
			break;
		case 'two':
			resultsDiv.style.gridTemplateColumns = '1fr 1fr';
			break;
		case 'three':
			resultsDiv.style.gridTemplateColumns = '1fr 1fr 1fr';
			break;
		case 'four':
			resultsDiv.style.gridTemplateColumns = '1fr 1fr 1fr 1fr';
			break;
		default:
			resultsDiv.style.gridTemplateColumns = '1fr 1fr 1fr';
		}
	}
	</script>
{% endblock %}