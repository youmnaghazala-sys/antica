								<path d="M15.4202 13.1499C14.8602 13.1499 14.4102 12.6999 14.4102 12.1499C14.4102 11.5999 14.8602 11.1499 15.4102 11.1499C15.9602 11.1499 16.4102 11.5999 16.4102 12.1499C16.4102 12.6999 15.9702 13.1499 15.4202 13.1499Z" fill="#FCFDFF"/>
								<path d="M8.42016 13.1499C7.86016 13.1499 7.41016 12.6999 7.41016 12.1499C7.41016 11.5999 7.86016 11.1499 8.41016 11.1499C8.96016 11.1499 9.41016 11.5999 9.41016 12.1499C9.41016 12.6999 8.97016 13.1499 8.42016 13.1499Z" fill="#FCFDFF"/>
								</svg>
							{{ product.add_to_cart_label }}
						</salla-add-product-button>
					</section>
					{% if product.is_giftable %}
						<salla-gifting class="mt-5" widget-subtitle="{{ gifting_intro }}" product-id="{{ product.id }}"></salla-gifting>
					{% endif %}
				</form>

				{% hook 'product:single.description.end' %}
				<salla-quick-order class="mt-5 md:-mb-2 block"></salla-quick-order>
			</div>
		</div>
		<salla-offer></salla-offer>
	</div>
	<div class="container mb-12" id="new-place">
		<salla-tabs>
			<!-- Tab One -->
			{% if product.description %}
				<salla-tab-header slot="header" name="tab_one">
					<span>{{trans('pages.cart.desproduct')}}</span>
				</salla-tab-header>
			{% endif %}
			<salla-tab-content slot="content" name="tab_one">
				{% if product.description %}
					<div class="" id="new-place">
						{% set product_desc = product.description|replace({"&nbsp;":"\n"}) %}
						<article class="article--main pb-1 text-base">
							{{ product_desc|raw }}
						</article>
					</div>
				{% endif %}
			</salla-tab-content>
			<!-- Tab Two -->
			<salla-tab-header slot="header" name="tab_two">
				<span>{{trans('pages.cart.ratingproduct')}}</span>
			</salla-tab-header>
			<salla-tab-content
				slot="content" name="tab_two">
				{# Comments Area #}
				<salla-comments item-id="{{product.id}}" type="product"></salla-comments>
			</salla-tab-content>

		</salla-tabs>
	</div>

	{# Similar Products Area #}
	<div class="container">
		<salla-products-slider source="related" source-value="{{product.id}}" block-title="{{trans('pages.products.similar_products')}}" display-all-url></salla-products-slider>
	</div>
{% endblock %}

{% block scripts %}
	<script defer src="{{ 'product.js' | asset }}"></script>
	{% if product.has_3d_image %}
		<script type="module" defer src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
	{% endif %}
{% endblock %}

